# ─── Entorno ──────────────────────────────────────────────────────────────────
# Entorno de ejecución: development | production
NODE_ENV=development

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Puerto en el que se levanta el servidor de desarrollo de Vite
FRONTEND_PORT=5173

# ─── Motor Prolog ─────────────────────────────────────────────────────────────
# Puerto del servidor Prolog (server.pl) y del proxy de Vite hacia la API.
# Cambiar este valor actualiza ambos a la vez.
PROLOG_PORT=8080
